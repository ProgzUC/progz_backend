# ===========================================
# Progz Backend — environment variables
# Copy to .env and fill in real values.
# Never commit .env to version control.
# ===========================================

PORT=5002
NODE_ENV=development

# Database (required) — use a local DB for development when possible
MONGO_URI=mongodb://127.0.0.1:27017/progz

# JWT (required — use long random strings; rotate if previously exposed)
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Frontend / CORS (comma-separated origins; no hardcoded production URLs in code)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Email (Brevo — used by the app)
BREVO_API_KEY=
FROM_EMAIL=

# Optional SMTP (only for verify_email_config.js legacy checks)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Cloudinary (required for file uploads — server-side only; never put these in Vite/VITE_*)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zen sync integration
ZEN_API_BASE_URL=
ZEN_API_KEY=
# Initial passwords for users synced from Zen (required when running sync)
ZEN_DEFAULT_TRAINER_PASSWORD=
ZEN_DEFAULT_STUDENT_PASSWORD=

# Bootstrap admin (optional — used by utils/createOrUpdateAdmin.js)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Demo seed scripts only (optional — required when running npm run seed:*)
DEMO_TRAINER_EMAIL=
DEMO_TRAINER_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=

# Local verification scripts only (optional)
TEST_API_BASE_URL=http://127.0.0.1:5002/api
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_TRAINER_EMAIL=
TEST_TRAINER_PASSWORD=
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
