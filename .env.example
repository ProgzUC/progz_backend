# ===========================================
# Progz Backend — environment variables
# Copy to .env and fill in real values.
# Never commit .env to version control.
# ===========================================

PORT=5002
NODE_ENV=development

# Database (required)
MONGO_URI=mongodb://127.0.0.1:27017/progz

# JWT (required — use long random strings; rotate if previously exposed)
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Email (Brevo)
BREVO_API_KEY=
FROM_EMAIL=

# Cloudinary (required for file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zen sync integration (optional)
ZEN_API_BASE_URL=
ZEN_API_KEY=

# Bootstrap admin (optional — used by utils/createOrUpdateAdmin.js)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Demo seed scripts only (optional — required when running npm run seed:*)
DEMO_TRAINER_EMAIL=
DEMO_TRAINER_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=

# Local verification scripts only (optional)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_TRAINER_EMAIL=
TEST_TRAINER_PASSWORD=
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
